# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# ActiveCampaign
AC_API_KEY=
AC_ACCOUNT_URL=
AC_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=

# Anthropic (Mario AI agent)
ANTHROPIC_API_KEY=

# Groq (trascrizione note vocali WhatsApp → testo, Whisper large-v3)
GROQ_API_KEY=

# Fenice (Mario) WhatsApp
TWILIO_WHATSAPP_NUMBER_FENICE=whatsapp:+393520413199
FENICE_OPENING_TEMPLATE_SID=HXa2da97153df29161cc4151a83b809e1e

# Secondo numero del bot (lib/mittente.ts), su un WABA e un account Twilio separati.
# Una conversazione NUOVA nasce sul secondo numero con probabilita' FENICE_NUMERO2_QUOTA
# (percentuale 0-100); una gia' avviata continua SEMPRE col numero con cui e' nata
# (`conversations.wa_number`). Quota assente, 0 o illeggibile = tutto sul primario
# (fail-closed). Il numero va elencato ANCHE in TWILIO_WHATSAPP_NUMBERS_2, insieme a
# TWILIO_ACCOUNT_SID_2/TWILIO_AUTH_TOKEN_2, perche' lib/twilio-account.ts scelga le
# credenziali giuste — e i template devono esistere sul suo account (i Content SID sono
# per account).
TWILIO_WHATSAPP_NUMBER_FENICE_2=
FENICE_NUMERO2_QUOTA=0

# Il bot prende in carico chi scrive per primo sul numero Fenice, senza passare dal CRM.
# '1' per accendere. Tre porte (lib/primo-messaggio.ts): link Telegram → TELEGRAM, pulsante
# del webinar → lancio post_pitch + 'Lancio Web Dev AI', altro → INBOUND. Il push al CRM
# (/api/bot/lead-entrante) parte in ogni caso; il CRM riconosce le tre provenienze.
#
# La terza porta ha un interruttore suo, e NON e' una env: il pulsante del webinar si
# accende la sera del 5/10 senza deploy, con la chiave `lancio_pulsante_attivo` di
# `app_settings` (nasce spenta, migrazione 20260916000001):
#   update app_settings set value='true'::jsonb where key='lancio_pulsante_attivo';
# Spenta, il marker del pulsante vale come assente ovunque (webhook e cron): chi scrive
# quella frase resta un inbound normale. Telegram va live ~19/09, il pulsante solo il
# 5/10: sono due date diverse e quindi due interruttori diversi.
#
# Nota: il cron manuale /api/cron/adotta-mai-risposti NON guarda INBOUND_ADOPTION_ENABLED
# — e' il recupero a mano dei "mai risposti", si lancia in POST con { esegui: true }
# quando serve, e per disegno deve poter adottare anche ad adozione spenta.
INBOUND_ADOPTION_ENABLED=0

# Dove spingere i lead appena adottati (verso opposto di /api/bot/lead-entranti): il CRM
# risponde col leadId. Default nel codice alla URL canonica di produzione — va valorizzata
# solo per puntare altrove (es. un ambiente di test del CRM).
CRM_LEAD_ENTRANTE_URL=

# Lancio Web Developer AI (webinar 5/10/2026) — SID dei 3 template creati da
# scripts/create-lancio-templates.mjs. Se Meta li approva MARKETING vanno anche in UTILITY_ONLY_ALLOW.
LANCIO_WELCOME_TEMPLATE_SID=
LANCIO_ZOOM_TEMPLATE_SID=
LANCIO_FOLLOWUP_TEMPLATE_SID=
# Tetto per run del cron /api/cron/lancio-aperture (default 100)
LANCIO_APERTURE_MAX_PER_RUN=100
# Tetto ORARIO dei benvenuti del lancio, intake realtime + cron insieme (spec §11.3,
# default 200). Oltre, il benvenuto non parte: il lead resta preso in carico e lo manda
# il cron piu' tardi. Serve a non rifare il picco del 15/09 che ha portato il numero a
# qualita' LOW. Valore illeggibile o 0 -> 200. Se il conteggio non si legge si differisce
# lo stesso (fail closed): il cron ripassa ogni 15 minuti.
LANCIO_WELCOME_MAX_PER_HOUR=200
# Conversazioni per run del blast del link Zoom, /api/cron/lancio-zoom (spec §11,
# delibera 16/09: 200 ogni 5', NON 400). ~3.000 iscritti in 16 run, dentro i 300s di
# Vercel con concorrenza 5. Valore illeggibile o 0 -> 200.
LANCIO_BATCH_MAX=200
# Base delle rotte del lancio sul CRM (/slots, /book, /call-now). Vuota = produzione.
CRM_LANCIO_URL=
# Orologio forzato dei turni del lancio (assistenza, post-pitch), SOLO per la prova generale:
# ISO con offset, es. 2026-10-05T22:40:00+02:00. Fuori produzione basta LANCIO_FAKE_NOW;
# in produzione vale solo se LANCIO_FAKE_NOW_ARMED e' uguale a CRON_SECRET. Toglierle dopo la prova.
LANCIO_FAKE_NOW=
LANCIO_FAKE_NOW_ARMED=
